{
  "name": "nikke-simul",
  "version": "0.0.0",
  "private": true,
  "description": "Local NIKKE account sync, versioned snapshots and simulation foundation.",
  "scripts": {
    "dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/sync.ps1 -Action dev",
    "build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/sync.ps1 -Action build",
    "dev:reference": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/web.ps1 -Action dev",
    "build:reference": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/web.ps1 -Action build",
    "test:reference": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/web.ps1 -Action test",
    "test": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify.ps1",
    "test:web": "npm --prefix apps/web test",
    "setup:sync": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/sync.ps1 -Action setup",
    "build:sync": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/sync.ps1 -Action build",
    "dev:sync": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/sync.ps1 -Action dev",
    "test:sync": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/sync.ps1 -Action test"
  }
}
